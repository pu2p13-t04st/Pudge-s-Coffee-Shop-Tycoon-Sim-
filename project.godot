; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pudge's Coffee Shop Tycoon Sim!"
run/main_scene="uid://ce7utnpg3uw8q"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Numbers="*uid://2u4kl3nolsqd"
Lists="*uid://8eraogo6i8vl"

[display]

window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://base_screen/": "gray",
"res://data_containers/": "green",
"res://data_containers/ceo_class/": "green",
"res://data_containers/company_class/": "green",
"res://data_containers/ingredient_class/": "green",
"res://data_containers/manager_class/": "green",
"res://data_containers/product_class/": "green",
"res://data_containers/store_class/": "green",
"res://global_scripts/": "blue",
"res://player_action_screens/": "red",
"res://player_action_screens/controls_screen/": "red",
"res://player_action_screens/store_listings_screen/": "red",
"res://player_action_screens/title_screen/": "red",
"res://visuals/": "purple"
}

[gui]

theme/default_font_antialiasing=0
theme/custom="uid://bvo3rltlf0snb"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
